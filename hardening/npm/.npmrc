# Slide 20 - PIN, LOCK, WAIT, INSPECT for npm (npm >= 11.10)

# PIN: `npm install x` writes "x": "1.2.3", never "^1.2.3"
save-exact=true

# WAIT: never resolve a version younger than 3 days (unit: DAYS)
# Note: `npm config get min-release-age` prints null - it is stored as `before`.
min-release-age=3
# Your own packages can skip the wait:
# min-release-age-exclude[]=@OWNER/*

# INSPECT (the cheap part): dependencies do not get to run code at install time.
# Re-enable per package with `npm rebuild <pkg>` when it really needs a build step.
ignore-scripts=true
